{
  "name": "@flowcamel/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "catalog:sync": "node ../../scripts/sync-camel-catalog.mjs",
    "build": "tsc",
