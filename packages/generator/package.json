{
  "name": "@flowcamel/generator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && rm -rf dist/templates dist/assets && cp -r src/templates dist/templates && cp -r src/assets dist/assets",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@flowcamel/core": "workspace:*",
    "handlebars": "^4.7.8",
    "archiver": "^6.0.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/handlebars": "^4.1.0",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0"
  }
}
